# DSPARK-Turbo: спекуляция + vision ВКЛЮЧЁН (максимум скорости).
# Драфтер калиброван под mrope: on-distribution -> accept 3.26
# (против 2.74 у vision-off, замер 2026-09-18: 95.4 vs 78.4 tok/s).
# Цена: vision-башня 0.92GB x каждую карту -> пул ~93-97k.
#
# Запуск:   docker compose --env-file profiles/dspark-turbo.env up -d --force-recreate
# Назад:    docker compose up -d --force-recreate

# --- Общие ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000
HF_CACHE_DIR=./hf-cache

# --- Профиль (= .env, но vision включён и контекст под меньший пул) ---
LANGUAGE_MODEL_ONLY=false
KV_CACHE_DTYPE=fp8_e4m3
# Пул с vision ~93-97k; контекст держать НИЖЕ пула (иначе краш аллокации)
CONTEXT_LENGTH=88000
PREFILL_CHUNK=1024
MAMBA_CACHE=4
MEM_FRACTION=0.87
MAX_RUNNING=1
GRAPH_BS=4
SPEC_ARGS=--speculative-algorithm DSPARK --speculative-draft-model-path gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4 --speculative-dspark-block-size 7 --speculative-draft-model-quantization modelopt_fp4
