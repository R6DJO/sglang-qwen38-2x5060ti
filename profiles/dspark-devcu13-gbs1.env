# ТЕСТОВЫЙ профиль (26.09): образ dev-cu13 + GRAPH_BS=1 + CONTEXT_LENGTH=144000.
# Графы decode bs 2-4 при MAX_RUNNING=1 дают только -60MB хвоста VRAM,
# на пул не влияют (замер 26.09: 149,414 в обоих) -> bs=1 как чистый эксперимент
# на dev-билде. Откат:
#   docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

# --- Образ (ТЕСТ) ---
SGLANG_IMAGE=lmsysorg/sglang:dev-cu13
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU (= dspark-ctx144, кроме GRAPH_BS) ---
MEM_FRACTION=0.87
PREFILL_CHUNK=1024
GRAPH_BS=1
CONTEXT_LENGTH=144000
MAX_RUNNING=1
MAMBA_CACHE=8

# = dspark-ctx144: дефолтный sampling t=0.6/top_p=0.95/top_k=20 (см. там)
# ВНИМАНИЕ (26.09): форма значения важна! JSON внутри .env нужно писать
# с внешними кавычками и экранированными внутренними ("{\"a\":1}"), иначе
# YAML-пересборка command в compose срезает кавычки -> sglang падает с
# 'invalid loads value' (было: рестарт-луп).
EXTRA_ARGS=--preferred-sampling-params "{\"temperature\":0.6,\"top_p\":0.95,\"top_k\":20}"
