# ТЕСТОВЫЙ профиль (2026-09-21): dspark-ctx144 + GRAPH_BS=1.
# MAX_RUNNING=1 -> реальный батч декода всегда 1; графы bs 2-4 — чистый
# расход VRAM. Замер: сколько пула возвращает GRAPH_BS=1.
# Следить: "Disable DSpark draft cuda graph" в логах = спекуляция деградировала.
# Откат: docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

# --- Образ ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU (как в dspark-ctx144, кроме GRAPH_BS) ---
MEM_FRACTION=0.87
PREFILL_CHUNK=1024
GRAPH_BS=1
CONTEXT_LENGTH=144000
MAX_RUNNING=1
MAMBA_CACHE=8
