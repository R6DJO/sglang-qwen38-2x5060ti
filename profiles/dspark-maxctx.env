# ЭКСПЕРИМЕНТ 2026-09-21: DSPARK +400 MiB/карту (mem-fraction 0.895) ради контекста.
# База: .env (DSPARK, vision-off, single-stream). Риск по README: allocator tightness.
# Правило отката: скорость < ~70 tok/s (база 78.1) => вернуться на .env.
# --- Профиль по умолчанию: DSPARK-ускорялка ------------------------------
# Его запускает голый `docker compose up` (этот файл подхватывается
# автоматически). Остальные профили -- в profiles/*.env через
# `docker compose --env-file profiles/<имя>.env up -d` (см. README).
# Vision-off и DSPARK-спекуляция здесь НЕ заданы -- они берутся из
# дефолтов docker-compose.yml; при желании переопредели здесь
# LANGUAGE_MODEL_ONLY=false и/или SPEC_ARGS= (примеры: profiles/).

# --- Образ ---
# latest-cu130 = v0.5.20, CUDA 13 (нужно для Blackwell sm_120 / RTX 50xx)
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000

# --- Диск ---
# Кэш модели (монтируется в контейнер); вынести на другой диск — абсолютный путь
HF_CACHE_DIR=./hf-cache

# --- Память GPU (DSPARK-конфиг) ---
# Бюджет "веса target+draft + KV" (v0.5.x считает веса драфтера в бюджете).
# 0.87 + vision-off + mamba4 + prefill1024 + graph4: пул ~148k.
# 0.88 без этих рычагов проверен: аллокатору тесно, шаг -33%.
MEM_FRACTION=0.895

# Активации: чанк префилла и максимум CUDA-графов (single-stream режим).
# Большие prompt'ы будут префилляться медленнее, но так +10k к пулу.
PREFILL_CHUNK=1024
GRAPH_BS=4
# Лимит на запрос = реальный KV-пул (max_total_num_tokens), чтобы
# сервер отклонял сверхдлинные запросы, а не ронял шедулер
# (148679 в текущем запуске; context_length > пула = краш на аллокации,
# как с mamba-пулом). Ниже ~148000 не опускать.
CONTEXT_LENGTH=155000
# 148k-контекст = single-stream: 1 запрос + 4 mamba-слота (mamba-пул
# 1.18 -> 0.59GB). Concurrency 2+ вернёт пул к ~155k (MAX_RUNNING=2,
# MAMBA_CACHE=8) — выбирать в зависимости от задачи.
MAX_RUNNING=1
# GDN state-слотов = MAX_RUNNING x 4 (стратегия extra_buffer_lazy)
MAMBA_CACHE=4
