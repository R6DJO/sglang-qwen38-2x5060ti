# ТЕСТОВЫЙ профиль (2026-09-21): dspark-ctx144 + PREFILL_CHUNK=2048.
# Проверка README-утверждения ">1024 на GDN подвешивает декод" на живом
# билде v0.5.20. Замер: пул, decode, TTFT на промпте ~27k ток.
# Откат: docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

# --- Образ ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU (как в dspark-ctx144, кроме PREFILL_CHUNK) ---
MEM_FRACTION=0.87
PREFILL_CHUNK=2048
GRAPH_BS=4
CONTEXT_LENGTH=140000
MAX_RUNNING=1
MAMBA_CACHE=8
