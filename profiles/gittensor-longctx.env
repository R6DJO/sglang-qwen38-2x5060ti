# 2026-09-29: ИТОГ серии замеров (замерено bench 5x512 + max_total_num_tokens):
# 1) Нативный EAGLE/MTP на nvidia/Qwen3.8-27B-NVFP4 НЕ ВЛЕЗАЕТ: MTP-голова bf16
#    = 2.82GB/карту; при 0.87 рестарт-луп, потолок при 0.95 ~ 50-60k контекста.
#    Нативный MTP и >144k несовместимы на 2x16GB.
# 2) nvidia/Qwen3.8-27B-NVFP4 без спекуляции: пул 196,786, decode 38.2.
# 3) gittensor RTX5090 (эта модель) без спекуляции: пул 293,938, decode 43.6 --
#    лучше nvidia по всему (легче веса, NVFP4 lm_head). ВЫБРАН.
# Цена отказа от DSpark: decode 78.2 -> 43.6 (спекуляция давала x1.4-1.8).
# Вернуть скорость: SPEC_ARGS на DSpark -- но пул упадёт до ~145k.
# Пул ПЛАВАЕТ между рестартами -- после каждого старта сверять:
#   docker logs sglang-qwen38-27b-nvfp4 2>&1 | grep -oE "max_total_num_tokens[=: ]+[0-9]+" | tail -1

# --- Образ / порт: как в dspark-ctx144 ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000
CONTAINER_NAME=sglang-qwen38-27b-nvfp4
HF_CACHE_DIR=./hf-cache

# --- Модель: gittensor RTX5090 (NVFP4 lm_head, без MTP-головы) ---
MODEL_PATH=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090
SERVED_NAME=qwen3.8-27b

# --- Память ---
# mem-fraction не трогаем: 0.88+ на этом железе = обрыв скорости (README).
MEM_FRACTION=0.87
GRAPH_BS=4
MAX_RUNNING=1
# Слотов mamba: 8 = запас против краша аллокатора на чанковом префилле
# (как в dspark-ctx144; 4 не хватало).
MAMBA_CACHE=8

# --- Контекст: 260000. ЛИМИТ ЧЕКПОЙНТА = 262,144 (производный; выше -- ValueError
# без SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1, не поднимать!). Замеренный
# пул 293,938 -- запас ~34k (пул плавает между рестартами) ---
CONTEXT_LENGTH=260000

# --- Спекуляция: ВЫКЛЮЧЕНА. Пустая строка гасит DSpark-дефолт из compose ---
SPEC_ARGS=

# Vision off (как в текущем), дефолтный sampling -- из dspark-ctx144.env
LANGUAGE_MODEL_ONLY=true
EXTRA_ARGS=--preferred-sampling-params "{\"temperature\":0.6,\"top_p\":0.95,\"top_k\":20}"
