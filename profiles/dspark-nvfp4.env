# ЭКСПЕРИМЕНТ — СЕЙЧАС ЗАБЛОКИРОВАН UPSTREAM (проверено 2026-09-18, v0.5.20 и main):
# nvfp4-KV для MHA-моделей не работает ни с одним доступным на SM120 бэкендом:
#   - flashinfer: assert KV4_ATTENTION_MHA_BACKEND_CHOICES (разрешён только MLA)
#   - triton: проходит валидацию, пул аллоцируется (у нас вышло 210k токенов,
#     x1.4 к fp8), но кернел extend падает: KeyError 'float4_e2m1fn_x2'
#   - trtllm_mha: нет сбортки под SM120
# Профиль оставлен как задел: когда MHA-путь доведут — просто снять
# пометку и прогнать бенч заново.
# Песочница: порт 30001, отдельный контейнер; основной сервис
# должен быть ОСТАНОВЛЕН (GPU общие).
#
# Запуск:   docker stop sglang-qwen38-27b-nvfp4 && docker compose \
#             -p qwen38-nvfp4-test --env-file profiles/dspark-nvfp4.env up -d
# Останов:  docker compose -p qwen38-nvfp4-test down && docker start sglang-qwen38-27b-nvfp4

# --- Общие + идентичность песочницы ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30001
HF_CACHE_DIR=./hf-cache
CONTAINER_NAME=sglang-qwen38-nvfp4-test

# --- Профиль (= .env, кроме KV-типа; контекст консервативно под ожидаемый пул) ---
# ВАЖНО: nvfp4-KV несовместим с flashinfer (assert KV4_ATTENTION_MHA_
# BACKEND_CHOICES, v0.5.20); trtllm_mha нет на SM120 -> triton.
LANGUAGE_MODEL_ONLY=true
KV_CACHE_DTYPE=nvfp4
ATTENTION_BACKEND=triton
CONTEXT_LENGTH=180000
PREFILL_CHUNK=1024
MAMBA_CACHE=4
MEM_FRACTION=0.87
MAX_RUNNING=1
GRAPH_BS=4
SPEC_ARGS=--speculative-algorithm DSPARK --speculative-draft-model-path gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4 --speculative-dspark-block-size 7 --speculative-draft-model-quantization modelopt_fp4
