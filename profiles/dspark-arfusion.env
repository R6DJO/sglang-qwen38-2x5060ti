# ТЕСТОВЫЙ профиль (2026-09-21): dspark-ctx144 + flashinfer allreduce fusion
# (официально включён для SM12x, PR #18758). Осторожно: на этой машине P2P
# запрещён драйвером -- если сервер не поднимется или упадёт, флаг снять.
# Откат: docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

# --- Образ ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU (как в dspark-ctx144) ---
MEM_FRACTION=0.87
PREFILL_CHUNK=1024
GRAPH_BS=4
CONTEXT_LENGTH=140000
MAX_RUNNING=1
MAMBA_CACHE=8

# --- Тестируемый флаг ---
EXTRA_ARGS=--enable-flashinfer-allreduce-fusion
