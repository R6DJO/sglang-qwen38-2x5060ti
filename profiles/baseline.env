# Baseline: спекуляция ВЫКЛЮЧЕНА, vision ВКЛЮЧЕН, полный контекст 192k,
# конкурентность 2. Пул ~229k, decode ~40.6 tok/s (1 клиент) / ~38.8x2 (2 клиента).
#
# Запуск:   docker compose --env-file profiles/baseline.env up -d --force-recreate
# Назад:    docker compose up -d --force-recreate

# --- Общие (дублируются в каждом профиле: --env-file заменяет .env целиком) ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000
HF_CACHE_DIR=./hf-cache

# --- Профиль ---
LANGUAGE_MODEL_ONLY=false
KV_CACHE_DTYPE=fp8_e4m3
CONTEXT_LENGTH=196608
PREFILL_CHUNK=1024
MAMBA_CACHE=8
MEM_FRACTION=0.87
MAX_RUNNING=2
GRAPH_BS=4
SPEC_ARGS=
