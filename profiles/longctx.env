# Максимальный контекст: спекуляция ВЫКЛЮЧЕНА, vision ВЫКЛЮЧЕН.
# Освобождает ~1.94GB (веса драфтера + его CUDA-графы + спек-воркспейс)
# -> KV-пул ~320k токенов, decode ~43.5 tok/s (single-stream).
#
# Запуск:   docker compose --env-file profiles/longctx.env up -d --force-recreate
# Назад:    docker compose up -d --force-recreate

# --- Общие ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000
HF_CACHE_DIR=./hf-cache

# --- Профиль ---
LANGUAGE_MODEL_ONLY=true
KV_CACHE_DTYPE=fp8_e4m3
CONTEXT_LENGTH=262144
PREFILL_CHUNK=1024
MAMBA_CACHE=4
MEM_FRACTION=0.87
MAX_RUNNING=1
GRAPH_BS=4
SPEC_ARGS=
