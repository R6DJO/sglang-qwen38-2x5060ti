# ТЕСТОВЫЙ профиль (2026-09-21): dspark-ctx144 + MAX_RUNNING=2.
# Проверка: крашится ли шедулер на перекрытии при mamba8 (4 слота/запрос
# x 2 запроса = ровно 8 слотов, без запаса). CONTEXT_LENGTH и остальное
# не тронуты -- статической цены у конкурентности нет.
# Если пул после рестарта < 140000 -- понизить CONTEXT_LENGTH.
# Откат: docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

# --- Образ ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU (как в dspark-ctx144) ---
MEM_FRACTION=0.87
PREFILL_CHUNK=1024
GRAPH_BS=4
CONTEXT_LENGTH=140000
MAX_RUNNING=2
MAMBA_CACHE=8
