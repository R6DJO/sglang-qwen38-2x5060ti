# 2026-09-30: Тест DFlash2 (gittensor target + incoai/Qwen3.8-27B-DFlash2)
# Target:   gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090 (проверенный, пул ~149k)
# Drafter:  incoai/Qwen3.8-27B-DFlash2 (block-diffusion draft, block size 8)
#           Работает с NVFP4-таргетом: селектор проецирует кандидатов через
#           квантованный lm_head (cookbook Qwen3.8-27B, раздел DFlash2).
# Пины cookbook для RTX 5090 32GB: DFlash2 = mem-fraction 0.91 + prefill 1024.
# У нас 2x16GB (теснее одной 32GB карты), стартуем с проверенных 0.875;
# 0.91 -- кандидат на второй заход, если пул будет с запасом.
# Порт 30000, всё остальное -- из dspark-ctx144.env.

# --- Образ ---
SGLANG_IMAGE=lmsysorg/sglang:dev-cu13
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU ---
MEM_FRACTION=0.875
GRAPH_BS=1
# ТЕСТ 30.09 (вечер): фактический пул 89,607 (draft DFlash2 тяжелее
# DSpark: ~149k -> ~89.6k при том же таргете). 85000 = запас ~4.6k.
CONTEXT_LENGTH=240000  # 30.09 (ночь): NGRAM пул 253,645; запас ~13k
MAX_RUNNING=1
MAMBA_CACHE=6  # 30.09: 8->6 при активном skip-lock (S=3), +~10k пула; следить за "Can not alloc mamba cache"

# --- Спекуляция: NGRAM (без драфтера) ---
# NGRAM: breadth=1 (минимальный verify-блок); мусорный профиля dflash-test устарел;

# 30.09 (ночь): NGRAM -- спекуляция без драфтера (пул = таргет ~155k).
SPEC_ARGS=--speculative-algorithm NGRAM --speculative-ngram-max-bfs-breadth 1

EXTRA_ARGS=--preferred-sampling-params "{\"temperature\":0.6,\"top_p\":0.95,\"top_k\":20}"

# ТЕСТ 30.09 (ночь): освобождение одного mamba-слота (lazy 4 -> 3).
# Ожидание: +несколько тысяч токенов пула; проверить по логу.
SGLANG_OPT_MAMBA_SKIP_DECODE_LOCK=1
