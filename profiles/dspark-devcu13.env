# ТЕСТОВЫЙ профиль (2026-09-21): dspark-ctx144 на образе dev-cu13 (2026-09-01)
# вместо latest-cu130 (v0.5.20, 2026-08-21). Проверка: есть ли в dev фиксы
# для Qwen3.8/GDN/DSPARK, влияющие на скорость/пул.
# Откат: docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

# --- Образ (ТЕСТ) ---
SGLANG_IMAGE=lmsysorg/sglang:dev-cu13
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU (как в dspark-ctx144) ---
MEM_FRACTION=0.87
PREFILL_CHUNK=1024
GRAPH_BS=4
CONTEXT_LENGTH=144000
MAX_RUNNING=1
MAMBA_CACHE=8
