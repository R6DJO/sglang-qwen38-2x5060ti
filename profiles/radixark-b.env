# 2026-09-XX: Тест оригинального RadixArk/Qwen3.8-27B-NVFP4 (вариант B)
# Target:   RadixArk/Qwen3.8-27B-NVFP4 (оригинальный чекпоинт RadixArk,
#           NVFP4 W4A4 gs16, attention FP8; форк gittensor -- та же база)
# Drafter:  gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4 (текущий рабочий,
#           quantization modelopt_fp4 -- из дефолта docker-compose.yml)
# Всё остальное -- копия dspark-ctx144.env (проверенный DSPARK-профиль).
# Порт 30000 (по просьбе; основной сервис на время теста остановить:
#   docker compose -p <имя-осн-проекта> down  или  docker stop <container>).

# --- Образ ---
SGLANG_IMAGE=lmsysorg/sglang:dev-cu13
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Модель: единственное отличие от дефолта compose ---
MODEL_PATH=RadixArk/Qwen3.8-27B-NVFP4
# SPEC_ARGS не задаём: дефолт compose уже Drafter gittensor DSpark-NVFP4
# (block 7, modelopt_fp4) -- это и есть вариант B.

# --- Память GPU (как в dspark-ctx144.env) ---
MEM_FRACTION=0.875
GRAPH_BS=1
CONTEXT_LENGTH=145000
MAX_RUNNING=1
MAMBA_CACHE=8

# Веса RadixArk-чекпоинта по размеру совпадают с gittensor-форком
# (~21.9 GB), поэтому MEMORY/пул-параметры не менялись. Если после
# старта пул < 145000 -- понизить CONTEXT_LENGTH (см. комментарий
# в dspark-ctx144.env).

EXTRA_ARGS=--preferred-sampling-params "{\"temperature\":0.6,\"top_p\":0.95,\"top_k\":20}"
