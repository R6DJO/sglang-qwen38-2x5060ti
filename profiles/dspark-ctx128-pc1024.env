# ТЕСТОВЫЙ профиль (серия 26.09): dspark-ctx144 + CONTEXT_LENGTH=128000
# + PREFILL_CHUNK=1024. Один из трёх профилей серии чанков префилла
# (1024/2048/4096); запускались скриптом run-ctx128-pc-series.sh.
# РЕЗУЛЬТАТЫ 26.09 (bench 5x512 + longprompt 27k, temp=0):
#   пул 149,414; decode 78.6 ток/с, e2e 75.3-75.4;
#   prefill 27k: 1764 ток/с (TTFT 15.5 с); OOM/крашей нет.
#   Вывод: чанк не влияет ни на пул, ни на decode; prefill +2% к 4096
#   (в пределах шума). MEM_FRACTION=0.87 хватило на всех чанках.
#   Аномалия: пул 149,414 при mamba8 (диапазон был 141.9-144.4k) --
#   плавание пула выше верхней границы, мониторить.
# Откат:
#   docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000
HF_CACHE_DIR=./hf-cache

MEM_FRACTION=0.87
PREFILL_CHUNK=1024
GRAPH_BS=4
CONTEXT_LENGTH=128000
MAX_RUNNING=1
MAMBA_CACHE=8
