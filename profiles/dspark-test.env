# Песочница DSPARK-экспериментов: отдельный проект (-p), контейнер и порт 30001.
# Работает ПАРАЛЛЕЛЬНО основному сервису, только если у основного освобождены GPU
# (обычно его останавливают: docker stop sglang-qwen38-27b-nvfp4).
#
# Запуск:   docker compose -p qwen38-dspark-test \
#             --env-file profiles/dspark-test.env up -d --force-recreate
# Логи:     docker compose -p qwen38-dspark-test logs -f
# Останов:  docker compose -p qwen38-dspark-test down
# bench.py: python3 bench.py http://localhost:30001 qwen3.8-27b-dspark-test

# --- Общие ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30001
HF_CACHE_DIR=./hf-cache

# --- Идентичность песочницы (не пересекаться с основным сервисом) ---
CONTAINER_NAME=sglang-qwen38-27b-nvfp4-dspark-test
SERVED_NAME=qwen3.8-27b-dspark-test

# --- Профиль (адаптация примера с одиночной 5090 под TP=2) ---
LANGUAGE_MODEL_ONLY=true
KV_CACHE_DTYPE=fp8_e4m3
CONTEXT_LENGTH=262144
PREFILL_CHUNK=2048
MAMBA_CACHE=8
MEM_FRACTION=0.86
MAX_RUNNING=2
GRAPH_BS=8
# Вся спекуляция одной строкой. NVFP4-драфтер по умолчанию (1.41GB):
SPEC_ARGS=--speculative-algorithm DSPARK --speculative-draft-model-path gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4 --speculative-dspark-block-size 7 --speculative-draft-model-quantization modelopt_fp4
# bf16-драфтер RadixArk (3.7GB, БЕЗ quant-флага -- иначе ошибка загрузки):
# SPEC_ARGS=--speculative-algorithm DSPARK --speculative-draft-model-path RadixArk/Qwen3.8-27B-DSpark --speculative-dspark-block-size 7
