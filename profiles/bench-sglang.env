# 2026-09-21: DSPARK 0.87 + mamba8 (защита от "Can not alloc mamba cache")
# + CONTEXT_LENGTH=144000 (запас от пула; пул плавает между рестартами).
# Цена: контекст 150k -> 144k; скорость должна остаться ~78 (mem-fraction не трогали).
# Риск: если пул после рестарта < 144000 - понизить CONTEXT_LENGTH.
# 21.09 (вечер): переименован из dspark-ctx150.env -- имя "ctx150" было
# историческим, контекст с тех пор 140k.
# 26.09: контекст 140000 -> 144000; профиль переименован
# dspark-ctx140.env -> dspark-ctx144.env (имя теперь совпадает с контекстом).
# Замеренный пул 148,989 -- выше ранее задокументированного
# mamba8-диапазона 141.9–144.4k, мониторить после каждого старта.
# --- Профиль по умолчанию: DSPARK-ускорялка ------------------------------
# Его запускает голый `docker compose up` (этот файл подхватывается
# автоматически). Остальные профили -- в profiles/*.env через
# `docker compose --env-file profiles/<имя>.env up -d` (см. README).
# Vision-off и DSPARK-спекуляция здесь НЕ заданы -- они берутся из
# дефолтов docker-compose.yml; при желании переопредели здесь
# LANGUAGE_MODEL_ONLY=false и/или SPEC_ARGS= (примеры: profiles/).

# --- Образ ---
# latest-cu130 = v0.5.20, CUDA 13 (нужно для Blackwell sm_120 / RTX 50xx)
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30001

# --- Диск ---
# Кэш модели (монтируется в контейнер); вынести на другой диск — абсолютный путь
HF_CACHE_DIR=./hf-cache
# HF_TOKEN: значение в окружении хоста (export); в файлы не вписывается

# --- Память GPU (DSPARK-конфиг) ---
# Бюджет "веса target+draft + KV" (v0.5.x считает веса драфтера в бюджете).
# 0.87 + vision-off + mamba8 + prefill1024 + graph4: пул ~144.4k
# (mamba4 давал ~151.7k; каждый +1 mamba-слот ~= -1.8k пула).
# 0.88 без этих рычагов проверен: аллокатору тесно, шаг -33%.
MEM_FRACTION=0.87

# Активации: чанк префилла и максимум CUDA-графов (single-stream режим).
# Большие prompt'ы будут префилляться медленнее, но так +10k к пулу.
#PREFILL_CHUNK=4096
GRAPH_BS=4
# Лимит на запрос = реальный KV-пул (max_total_num_tokens), чтобы
# сервер отклонял сверхдлинные запросы, а не ронял шедулер
# (148,989 в замере 26.09, mamba8; context_length > пула = краш
# на аллокации). 144000 = запас ~5k от замеренного пула.
CONTEXT_LENGTH=144000
# 144k-контекст = single-stream: 1 запрос + 8 mamba-слотов
# (mamba4: 150k-контекст, но 3/4 слотов заняты кэшем -> краш
# "Can not alloc mamba cache" на чанковом префилле во время декода).
MAX_RUNNING=1
# GDN state-слотов: 8 = запас против краша аллокатора (4 не хватало)
MAMBA_CACHE=8

# Дефолтный sampling для клиентов без явных параметров (pi temperature не
# передаёт -> получает эти; явный temperature клиента перекрывает, см.
# tokenizer_manager.py: {**preferred, **sampling_params}).
# Qwen3 thinking, "precise coding": t=0.6, top_p=0.95, top_k=20 (26.09).
# Применится со следующего рестарта профиля.
# Форма значения: внешние кавычки + экранированные внутренние -- иначе YAML
# в compose срезает кавычки и sglang падает ('invalid loads value', 26.09).
EXTRA_ARGS=--preferred-sampling-params "{\"temperature\":0.6,\"top_p\":0.95,\"top_k\":20}"
