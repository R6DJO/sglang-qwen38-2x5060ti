# ТЕСТОВЫЙ профиль (2026-09-21): dspark-ctx144 + --speculative-attention-mode decode.
# Дефолт 'prefill' заменён на 'decode' (официальный параметр: влияет на verify
# таргета и extension драфта). SPEC_ARGS заменяет весь DSPARK-блок целиком.
# Откат: docker compose --env-file profiles/dspark-ctx144.env up -d --force-recreate

# --- Образ ---
SGLANG_IMAGE=lmsysorg/sglang:latest-cu130
SGLANG_PORT=30000

# --- Диск ---
HF_CACHE_DIR=./hf-cache

# --- Память GPU (как в dspark-ctx144) ---
MEM_FRACTION=0.87
PREFILL_CHUNK=1024
GRAPH_BS=4
CONTEXT_LENGTH=140000
MAX_RUNNING=1
MAMBA_CACHE=8

# --- DSPARK + тестируемый флаг ---
SPEC_ARGS=--speculative-algorithm DSPARK --speculative-draft-model-path gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4 --speculative-dspark-block-size 7 --speculative-draft-model-quantization modelopt_fp4 --speculative-attention-mode decode
